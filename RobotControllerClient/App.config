<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- 기본 접속 정보. 프로그램 실행 후 UI에서 변경 가능하며, 종료 시 사용자 설정에 저장된다. -->
        <add key="DefaultIp" value="199.34.57.91" />
        <add key="DefaultPort" value="10110" />
        <!-- 명령 전송 후 응답(_RDY 등)을 기다리는 최대 시간(ms) -->
        <add key="ResponseTimeoutMs" value="30000" />
    </appSettings>
</configuration>
